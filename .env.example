# Required: Neon / Supabase / Railway Postgres
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@host/dbname?sslmode=require"

# Required: Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token"

# Cron job auth
CRON_SECRET="a-long-random-secret"

# Public app URL (Vercel sets VERCEL_URL; override for local dev)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
